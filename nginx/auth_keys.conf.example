# Copy to auth_keys.conf and set a real key. NOT committed.
#
# The key is BARE — the client sends `Authorization: <key>` with NO "Bearer "
# prefix, and this map must match that byte for byte. The example carried a
# "Bearer " prefix until 2026-08-21 while the deployed map never had one, so
# re-provisioning from this file produced 401 on every request.
map $http_authorization $search_authorized {
    default                       0;
    "CHANGE_ME_search_api_key"    1;
}
