# ──────────────────────────────────────────────
# edu_ai  –  Proměnné prostředí
# Zkopíruj do  .env  a doplň skutečné hodnoty, nebo nech
# scripts/bootstrap.py  vygenerovat silné hodnoty za každé CHANGE_ME_* níže.
#
# Všechny hodnoty jsou LITERÁLNÍ. Nepoužívej odkazy ${JINA_PROMENNA}: Compose
# by je interpoloval, ale scripts/envfile.py:read_env() ne — a tooling by se
# pak tiše rozešel s kontejnery v tom, co je vlastně nakonfigurováno.
# ──────────────────────────────────────────────

# ── Compose ───────────────────────────────────
# Fixuje jméno projektu. Bez toho si ho Compose odvodí z názvu SLOŽKY, takže
# klon do jinak pojmenovaného adresáře míří na jiný projekt — a `docker compose
# down` pak skončí s kódem 0, aniž by cokoli zastavil, protože hledal kontejnery,
# které tam nikdy nebyly. Je to zároveň prefix volume postgres_data: změna této
# hodnoty nasměruje stack na jiný (prázdný) volume.
COMPOSE_PROJECT_NAME=edu_ai

# Které compose soubory se načtou. Na dev stroji nechat zakomentované — Compose
# si sám přibere docker-compose.override.yml s porty na 127.0.0.1. Na serveru ten
# override nechceme (jediný vstup má být nginx) a sám se nevypne.
#COMPOSE_FILE=docker-compose.yml

# ── Postgres: konektivita ─────────────────────
# ⚠ DVĚ PRAVIDLA, KTERÁ SE NESMÍ PORUŠIT — každé z nich stálo celé odladění:
#
#  1. ŽÁDNÝ z pěti klíčů v tomto bloku nesmí být přidán do
#     LANGFLOW_VARIABLES_TO_GET_FROM_ENVIRONMENT (docker-compose.yml).
#     Most env → global variable v Langflow vytváří každou proměnnou, které se
#     dotkne, natvrdo jako typ Credential (konstanta,
#     langflow/services/variable/service.py:167) — a Credential proměnnou
#     ne-tajná StrInput pole ODMÍTAJÍ:
#       "Cannot use a Credential-typed global variable in 'pg_host'."
#     Rozbilo by to naráz 155 polí ve všech 6 flow. Ne-tajná konektivita proto
#     musí zůstat obyčejnou env proměnnou, kterou si flow vyzvednou přes
#     load_from_db → fallback na os.getenv.
#     Pozor i na druhou stranu: odebrání jména z toho seznamu proměnnou
#     z Langflow DB NESMAŽE — řádek je nutné zahodit ručně.
#
#  2. Nikdy nenastavuj LANGFLOW_FALLBACK_TO_ENV_VAR=false. Default je true a je
#     to přesně to, co dělá fallback z pravidla 1 funkčním. S vypnutým se
#     každé z těch 155 polí utne na "<JMÉNO> variable not found.". Secrety by
#     fungovaly dál (ty jsou v DB), takže chyba vypadá jako problém s Postgresem
#     nebo se sítí, ne jako přehozený konfigurační flag.
#
# Musí se rovnat container_name služby postgres — je to hostname, který si
# překládají flow i vyhledávací kontejner.
POSTGRES_DB_SERVER=edu_ai_postgres
POSTGRES_SERVER_PORT=5432
# Jediné jméno v tomto bloku dost obecné na to, aby si ho upstream Langflow mohl
# přidat do svého vestavěného variables_to_get_from_environment (je to vlastní
# proměnná oficiálního postgres image). Pokud se to stane, pravidlo 1 se poruší
# samo při upgradu — pak přejmenovat na POSTGRES_DB_NAME, což je 31 hodnot
# ve flow JSON.
POSTGRES_DB=edu_ai
POSTGRES_DB_SCHEMA=edu_ai
# Jediný kanonický DB uživatel. Čtou ho flow (přes os.getenv), inicializace
# samotné služby postgres, její healthcheck, edu_ai_search i smoke.py — všechno
# míří na TENTO klíč. Samostatný POSTGRES_USER už záměrně neexistuje; dva klíče
# pro jednu hodnotu se tiše rozejdou. (Komponenty ve flow mají na starý název
# ještě fallback `os.getenv("POSTGRES_DB_USER") or os.getenv("POSTGRES_USER")`,
# který se nikdy nepoužije — první getenv uspěje vždy.)
POSTGRES_DB_USER=edu_ai

# ── Postgres: secret ──────────────────────────
# Jediná hodnota z Postgresu, která se z env přenáší do Langflow Global
# Variable (typ Credential) — váže se na SecretStrInput pole, která ji přijímají.
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ── pgAdmin ───────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_pgadmin_password

# ── Langflow ──────────────────────────────────
# Vytváří scripts/create_api_key.py (přihlášení superusera → REST). Langflow CLI
# (`langflow api-key`) to odmítá, dokud platí LANGFLOW_AUTO_LOGIN=false.
LANGFLOW_API_KEY=CHANGE_ME_langflow_api_key
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME_langflow_admin_password
# Šifruje Langflow Global Variables. Nastavit jednou, před prvním startem, a už
# nikdy neměnit — existující proměnné by se přestaly dešifrovat a musely by se
# smazat a vytvořit znovu.
# Musí to být Fernet klíč: přesně 32 náhodných bajtů v url-safe base64 (44 znaků,
# koncové '='). Cokoli jiného skončí na "Fernet key must be 32 url-safe
# base64-encoded bytes" — obyčejné heslo podobné délky NESTAČÍ.
#   python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
LANGFLOW_SECRET_KEY=CHANGE_ME_langflow_secret_key

# Kde je Langflow dosažitelný Z HOSTU (kontejnery si jdou na http://edu_ai:7860
# po docker síti). Čtou bootstrap.py, create_api_key.py, import_flows.py i
# smoke.py. Na dev stroji zakomentované — 7860 publikuje override a skripty si
# port najdou samy. Bez override (server) 7860 nepublikuje nikdo a tohle je
# jediná cesta: nginx na 8444 proxuje totéž REST API.
#LANGFLOW_URL=http://127.0.0.1:8444

# Aliasy endpointů flow (LANGFLOW_FLOW_ID*) se tu už nenastavují — jsou to
# stabilní konstanty definované v docker-compose.yml, ne per-instance secrety.

# ── Web chat ──────────────────────────────────
# Příznak Secure na session cookie. Nechat zakomentované (tedy false), dokud
# nginx obsluhuje plain HTTP — Secure cookie prohlížeč nad http zahodí a chat
# tiše ztratí kontinuitu konverzace. Odkomentovat, až bude TLS před nginxem.
#CHAT_COOKIE_SECURE=true

# ── OpenAI (používají komponenty Langflow) ────
# Přenáší se z env do Credential Global Variable, takže se váže na SecretStrInput
# pole. Háček: jakmile tuhle proměnnou někdo upraví v Langflow UI, její
# updated_at překročí created_at, Langflow ji označí za user-modified a .env ji
# UŽ NIKDY nepřepíše. Měň hodnotu tady a restartuj; pokud se zdánlivě nic
# nestane, smaž proměnnou v UI a restartuj znovu.
OPENAI_API_KEY=CHANGE_ME_openai_api_key

# ── Bifrost — LLM brána ───────────────────────
# Langflow i search míří na bránu přes OPENAI_BASE_URL; výchozí hodnota
# v compose je http://bifrost:8080/openai/v1, takže tohle nech zakomentované.
# Odkomentuj jen pro obejití brány (přímo na OpenAI) při ladění.
#OPENAI_BASE_URL=https://api.openai.com/v1
#
# Na které adrese je dosažitelné webové UI brány. Bifrost NEMÁ vlastní
# autentizaci — kdo se dostane na port, vidí i mění všechny klíče poskytovatelů.
# Výchozí loopback (SSH tunel). <server> = kdokoli na WireGuardu, bez hesla.
# Nikdy 0.0.0.0 — to je veřejné rozhraní.
#
# Výchozí port je 8099, protože 8090 si v dev override bere edu_ai_search.
# Produkce override nenačítá (COMPOSE_FILE=docker-compose.yml), takže tam jde
# BIFROST_PORT=8090 nastavit a zachovat tím dosavadní http://<server>:8090.
#BIFROST_BIND=<server>
#BIFROST_PORT=8090
#BIFROST_LOG_LEVEL=debug
#
# ── Cloudflare tunel k UI brány ───────────────
# Token tunelu z Cloudflare Zero Trust. Prázdné = služba cloudflared se
# spustí, nepřipojí se a jen loguje chybu; nic jiného tím netrpí.
#
# Veřejný hostname tunelu míří na http://bifrost:8080 (jméno kontejneru na
# síti app), NE na publikovaný port hostitele. Přístup z WireGuardu přes
# BIFROST_BIND/BIFROST_PORT zůstává vedle toho nedotčený.
#
# POZOR: tunel sám nic neautentizuje a Bifrost nemá vlastní přihlášení.
# Na tom hostnamu MUSÍ být politika Cloudflare Access — bez ní je admin
# rozhraní se všemi klíči poskytovatelů veřejné.
#CLOUDFLARE_TUNNEL_TOKEN=

# ── CORS ──────────────────────────────────────
# Origins, kterým search a ingest API dovolí volání z prohlížeče. Prázdné =
# zavřeno, což je výchozí stav a v produkci správně: webchat volá své BFF přes
# nginx na stejném originu, mobilní appka je nativní klient (CORS se ho netýká)
# a Laravel by chodil server-to-server.
#
# Otevírej jen výslovně a jmenovitě. Nikdy `*` — na endpointu za autentizací se
# z toho stane díra, jakmile někdo zapne allow_credentials nebo přesune auth do
# cookie, a nikdo si ty dvě změny nespojí.
#
# Vývojové stránky tools/*.html chodí z disku přímo na :8090; když je někdo
# potřebuje, odkomentuje si tohle lokálně.
#CORS_ORIGINS=null,http://localhost:5173
# Klíče poskytovatelů se sem NEPÍŠOU. Žijí v bifrost_data/config.db a spravují
# se ve webovém UI brány (Providers).

# ── Volba modulu LangGraph ────────────────────
LANGGRAPH_MODULE=1

# ── Id nodů APIPipelineInput, zvlášť pro každý flow ──
# Node v daném flow, který přijímá tweak pipeline_input (volající flow ho mají
# v body-builderu prázdný a resolví ho odsud). Unikátní per flow, aby nedocházelo
# k prolévání vertex cache mezi flow (viz commity fix(langflow) z 2026-07-19).
LANGFLOW_PIPELINE_INPUT_NODE_MARKDOWN=APIPipelineInput-tfiG6-MD
LANGFLOW_PIPELINE_INPUT_NODE_WEB=APIPipelineInput-tfiG6-WEB
LANGFLOW_PIPELINE_INPUT_NODE_PDF=APIPipelineInput-tfiG6-PDF
LANGFLOW_PIPELINE_INPUT_NODE_OFFICE=APIPipelineInput-tfiG6-OFF
LANGFLOW_PIPELINE_INPUT_NODE_QA=APIPipelineInput-tfiG6-QA

# Id logovacích nodů tabulkové větve MARKDOWN flow (injektáž uuid přes tweaks),
# oddělené čárkou
LANGFLOW_MARKDOWN_LOGGER_NODES=IngestionLogger-AQC5h-MD
