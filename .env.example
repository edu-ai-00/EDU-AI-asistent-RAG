# Copy to .env; scripts/bootstrap.py generates the CHANGE_ME_* values. Values are LITERAL — no ${…}.

# ── Compose ───────────────────────────────────
# Do not change: it is the prefix of the postgres_data volume.
COMPOSE_PROJECT_NAME=edu_ai
# Leave commented out on a development machine.
#COMPOSE_FILE=docker-compose.yml

# ── Postgres: connectivity ────────────────────
# ⚠ Never add these 5 keys to LANGFLOW_VARIABLES_TO_GET_FROM_ENVIRONMENT and never set
# LANGFLOW_FALLBACK_TO_ENV_VAR=false (details in docs/DATA_MODEL_AND_SETUP.md). POSTGRES_DB_SERVER = the postgres container_name.
POSTGRES_DB_SERVER=edu_ai_postgres
POSTGRES_SERVER_PORT=5432
POSTGRES_DB=edu_ai
POSTGRES_DB_SCHEMA=edu_ai
POSTGRES_DB_USER=edu_ai_ingest

# ── Postgres: secret ──────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ── Postgres: roles ───────────────────────────
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_postgres_admin_password
POSTGRES_SEARCH_PASSWORD=CHANGE_ME_postgres_search_password
POSTGRES_LANGFLOW_PASSWORD=CHANGE_ME_postgres_langflow_password
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_postgres_migrator_password

# ── pgAdmin ───────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@edu-ai.eu
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_pgadmin_password

# ── Langflow ──────────────────────────────────
LANGFLOW_API_KEY=CHANGE_ME_langflow_api_key
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME_langflow_admin_password
# ⚠ Set once before the first start and NEVER change it. It must be a Fernet key (a plain password will not do):
#   python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
LANGFLOW_SECRET_KEY=CHANGE_ME_langflow_secret_key
# Commented out on a development machine; on a server nginx 8444.
#LANGFLOW_URL=http://127.0.0.1:8444

# ── Web chat ──────────────────────────────────
# Leave commented out while nginx serves only HTTP; uncomment with TLS.
#CHAT_COOKIE_SECURE=true

# ── Jina — reranker prefilter (optional) ──────
# The settings (rerank_prefilter.backend = jina) switch it on; without a key search skips the prefilter
# (it continues without it, a warning in the log, the smoke prints [note]). A key from jina.ai; search calls it directly, not through Bifrost.
JINA_API_KEY=

# ── OpenAI (used by the Langflow components) ──
# ⚠ Once edited in the Langflow UI, the .env no longer overwrites it — change it here or delete the variable in the UI, and restart.
OPENAI_API_KEY=CHANGE_ME_openai_api_key

# ── Bifrost — LLM gateway ─────────────────────
# The default is the gateway from compose; uncomment only to bypass the gateway while debugging.
#OPENAI_BASE_URL=https://api.openai.com/v1
# bifrost/config.json creates the gateway UI admin from these values; the installer generates the password.
# To change the password: rewrite it here and recreate the container (`docker compose … up -d bifrost`; a restart does not read the .env value). Without a password Bifrost does not start.
BIFROST_ADMIN_USERNAME=admin@edu-ai.eu
BIFROST_ADMIN_PASSWORD=CHANGE_ME_bifrost_admin_password
# Fallback access to /api if the UI login is ever switched off; the installer generates it. ⚠ Never bind the gateway to 0.0.0.0.
BIFROST_SETUP_TOKEN=CHANGE_ME_bifrost_setup_token
#BIFROST_BIND=<server>
#BIFROST_PORT=8099
#BIFROST_LOG_LEVEL=debug

# ── Cloudflare tunnel to the gateway UI ───────
# Optional (COMPOSE_PROFILES=cloudflare + token). ⚠ The hostname MUST be behind Cloudflare Access — neither the tunnel nor Bifrost authenticates anything.
#COMPOSE_PROFILES=cloudflare
#CLOUDFLARE_TUNNEL_TOKEN=

# ── CORS ──────────────────────────────────────
# Empty = closed (the default). Open only by name, never `*`.
#CORS_ORIGINS=null,http://localhost:5173

# ── LangGraph module choice ───────────────────
LANGGRAPH_MODULE=1

# ── APIPipelineInput node ids, one per flow ───
LANGFLOW_PIPELINE_INPUT_NODE_MARKDOWN=APIPipelineInput-tfiG6-MD
LANGFLOW_PIPELINE_INPUT_NODE_WEB=APIPipelineInput-tfiG6-WEB
LANGFLOW_PIPELINE_INPUT_NODE_PDF=APIPipelineInput-tfiG6-PDF
LANGFLOW_PIPELINE_INPUT_NODE_OFFICE=APIPipelineInput-tfiG6-OFF
LANGFLOW_PIPELINE_INPUT_NODE_QA=APIPipelineInput-tfiG6-QA
# Comma-separated.
LANGFLOW_MARKDOWN_LOGGER_NODES=IngestionLogger-AQC5h-MD

# Required manual installation input; no default school.
CHAT_LEGAL_ENTITY=CHANGE_ME_legal_entity_code
