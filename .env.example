# Zkopíruj do .env; za CHANGE_ME_* hodnoty vygeneruje scripts/bootstrap.py. Hodnoty jsou LITERÁLNÍ – bez ${…}.

# ── Compose ───────────────────────────────────
# Neměnit: je to prefix volume postgres_data.
COMPOSE_PROJECT_NAME=edu_ai
# Na dev stroji nechat zakomentované.
#COMPOSE_FILE=docker-compose.yml

# ── Postgres: konektivita ─────────────────────
# ⚠ Těchto 5 klíčů nikdy nepřidávat do LANGFLOW_VARIABLES_TO_GET_FROM_ENVIRONMENT a nikdy nenastavovat
# LANGFLOW_FALLBACK_TO_ENV_VAR=false (podrobně v docs/DATA_MODEL_AND_SETUP.md). POSTGRES_DB_SERVER = container_name postgres.
POSTGRES_DB_SERVER=edu_ai_postgres
POSTGRES_SERVER_PORT=5432
POSTGRES_DB=edu_ai
POSTGRES_DB_SCHEMA=edu_ai
POSTGRES_DB_USER=edu_ai_ingest

# ── Postgres: secret ──────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ── Postgres: role ────────────────────────────
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_postgres_admin_password
POSTGRES_SEARCH_PASSWORD=CHANGE_ME_postgres_search_password
POSTGRES_LANGFLOW_PASSWORD=CHANGE_ME_postgres_langflow_password
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_postgres_migrator_password

# ── pgAdmin ───────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_pgadmin_password

# ── Langflow ──────────────────────────────────
LANGFLOW_API_KEY=CHANGE_ME_langflow_api_key
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=CHANGE_ME_langflow_admin_password
# ⚠ Nastavit jednou před prvním startem a NIKDY neměnit. Musí to být Fernet klíč (obyčejné heslo nestačí):
#   python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
LANGFLOW_SECRET_KEY=CHANGE_ME_langflow_secret_key
# Na dev stroji zakomentované; na serveru nginx 8444.
#LANGFLOW_URL=http://127.0.0.1:8444

# ── Web chat ──────────────────────────────────
# Nechat zakomentované, dokud nginx obsluhuje jen HTTP; odkomentovat s TLS.
#CHAT_COOKIE_SECURE=true

# ── OpenAI (používají komponenty Langflow) ────
# ⚠ Po úpravě v Langflow UI ji .env už nepřepíše – změň ji tady, případně smaž proměnnou v UI, a restartuj.
OPENAI_API_KEY=CHANGE_ME_openai_api_key

# ── Bifrost — LLM brána ───────────────────────
# Výchozí je brána z compose; odkomentovat jen pro obejití brány při ladění.
#OPENAI_BASE_URL=https://api.openai.com/v1
# ⚠ Dashboard brány je bez hesla, dokud v něm nevytvoříte admin účet – nikdy 0.0.0.0.
# Do té doby chce každé /api volání (i UI) tento token; vygeneruje ho instalace (bifrost/config.json jej čte z env).
BIFROST_SETUP_TOKEN=CHANGE_ME_bifrost_setup_token
#BIFROST_BIND=<server>
#BIFROST_PORT=8099
#BIFROST_LOG_LEVEL=debug

# ── Cloudflare tunel k UI brány ───────────────
# Volitelné (COMPOSE_PROFILES=cloudflare + token). ⚠ Na hostnamu MUSÍ být Cloudflare Access – tunel ani Bifrost nic neautentizují.
#COMPOSE_PROFILES=cloudflare
#CLOUDFLARE_TUNNEL_TOKEN=

# ── CORS ──────────────────────────────────────
# Prázdné = zavřeno (výchozí). Otevírat jen jmenovitě, nikdy `*`.
#CORS_ORIGINS=null,http://localhost:5173

# ── Volba modulu LangGraph ────────────────────
LANGGRAPH_MODULE=1

# ── Id nodů APIPipelineInput, zvlášť pro každý flow ──
LANGFLOW_PIPELINE_INPUT_NODE_MARKDOWN=APIPipelineInput-tfiG6-MD
LANGFLOW_PIPELINE_INPUT_NODE_WEB=APIPipelineInput-tfiG6-WEB
LANGFLOW_PIPELINE_INPUT_NODE_PDF=APIPipelineInput-tfiG6-PDF
LANGFLOW_PIPELINE_INPUT_NODE_OFFICE=APIPipelineInput-tfiG6-OFF
LANGFLOW_PIPELINE_INPUT_NODE_QA=APIPipelineInput-tfiG6-QA
# Oddělené čárkou.
LANGFLOW_MARKDOWN_LOGGER_NODES=IngestionLogger-AQC5h-MD

# Required manual installation input; no default school.
CHAT_LEGAL_ENTITY=CHANGE_ME_legal_entity_code
