  "baseline": {
    "cluster_databases": ["edu_ai", "langflow", "postgres", "template0", "template1"],
    "edu_ai": {
      "schemas": ["edu_ai", "paradedb", "pdb", "public"],
      "extensions": {"pg_search": "0.25.1", "pg_trgm": "1.6", "plpgsql": "1.0", "unaccent": "1.1", "vector": "0.7.4"},
      "sequences": ["answer_exclusion_rule_id_seq", "chunk_exclusion_rule_id_seq", "code_list_id_seq", "edu_ai_document_chunks_id_seq", "edu_ai_document_elements_id_seq",
                    "edu_ai_document_tables_id_seq", "grade_term_id_seq", "ingestion_log_id_seq", "prompt_registry_id_seq", "qa_blocklist_id_seq", "qa_feedback_id_seq",
                    "qa_synonym_id_seq", "qa_variants_variant_id_seq", "question_answer_log_id_seq", "subject_term_id_seq", "system_message_id_seq",
                    "taxonomy_binding_id_seq", "taxonomy_rules_id_seq", "ui_label_id_seq", "validity_period_id_seq"],
      "functions": ["chunk_codes_valid", "code_list_identity_is_immutable", "codebook_owner_must_be_root", "entity_grade_scope", "grade_level", "grade_levels_drift",
                    "language_selection_must_exist", "provision_school_code_lists", "qa_duplicate_questions", "qa_entry_category_must_be_valid", "qa_pack_drift",
                    "resolved_code_list", "resolved_taxonomy_rules", "settings_owner_must_be_root"]
