{
  "format": 2,
  "contract": "C2 DB role contract (owner approval 2026-10-09, isolated synthetic installations only)",
  "marker": "role-contract:2",
  "roles": {
    "edu_ai_admin":    {"login": true,  "superuser": true,  "createdb": true,  "createrole": true,  "replication": true,  "bypassrls": true,  "inherit": true,  "note": "maintenance and restore; never an application credential"},
    "edu_ai_owner":    {"login": false, "superuser": false, "createdb": false, "createrole": false, "replication": false, "bypassrls": false, "inherit": false, "note": "owns the EDU-AI schema and application objects; nobody holds a membership except the migrator (SET only)"},
    "edu_ai_search":   {"login": true,  "superuser": false, "createdb": false, "createrole": false, "replication": false, "bypassrls": false, "inherit": false, "search_path": ["edu_ai", "public"], "note": "search service and QA admin API (pg_trgm functions and operators live in schema edu_ai and are used unqualified)"},
    "edu_ai_ingest":   {"login": true,  "superuser": false, "createdb": false, "createrole": false, "replication": false, "bypassrls": false, "inherit": false, "search_path": ["edu_ai", "public"], "note": "Langflow flow components (variables POSTGRES_DB_USER / POSTGRES_PASSWORD)"},
    "edu_ai_langflow": {"login": true,  "superuser": false, "createdb": false, "createrole": false, "replication": false, "bypassrls": false, "inherit": false, "note": "owns the langflow database and its vendor objects only"},
    "edu_ai_migrator": {"login": true,  "superuser": false, "createdb": false, "createrole": false, "replication": false, "bypassrls": false, "inherit": false, "note": "maintenance migrator; SET ROLE edu_ai_owner for allowed EDU-AI schema steps"}
  },
  "login_secrets": {"edu_ai_admin": "POSTGRES_ADMIN_PASSWORD", "edu_ai_search": "POSTGRES_SEARCH_PASSWORD", "edu_ai_ingest": "POSTGRES_PASSWORD",
                    "edu_ai_langflow": "POSTGRES_LANGFLOW_PASSWORD", "edu_ai_migrator": "POSTGRES_MIGRATOR_PASSWORD"},
  "memberships": [{"role": "edu_ai_owner", "member": "edu_ai_migrator", "inherit": false, "set": true}],
  "legacy_roles": ["edu_ai"],
  "runtime_roles": ["edu_ai_search", "edu_ai_ingest"],
  "databases": {
    "postgres": {"owner": "edu_ai_admin",   "connect": []},
    "edu_ai":   {"owner": "edu_ai_admin",   "connect": ["edu_ai_search", "edu_ai_ingest", "edu_ai_migrator"]},
    "langflow": {"owner": "edu_ai_langflow", "connect": ["edu_ai_langflow"]}
  },
  "public_revoked_databases": ["template1"],
  "edu_ai_db": {
    "schema_owner": "edu_ai_owner",
    "object_owner": "edu_ai_owner",
    "schema_usage": {"edu_ai": ["edu_ai_search", "edu_ai_ingest", "edu_ai_owner"],
                     "public": ["edu_ai_search", "edu_ai_ingest", "edu_ai_owner"],
                     "paradedb": ["edu_ai_search", "edu_ai_ingest", "edu_ai_owner"],
                     "pdb": ["edu_ai_search", "edu_ai_ingest", "edu_ai_owner"]},
    "extension_owner_note": "extensions and their objects stay with the maintenance role (admin on clean installs, the NOLOGIN bootstrap role on adoption)",
    "S_all_tables_for": ["edu_ai_search", "edu_ai_ingest"],
    "definer_functions": [],
    "table_dml": {
      "answer_exclusion_rule": {},
      "app_user": {},
      "chunk_exclusion_rule": {},
      "code_list": {"edu_ai_search": "I"},
      "document_chunks": {"edu_ai_ingest": "IUD"},
