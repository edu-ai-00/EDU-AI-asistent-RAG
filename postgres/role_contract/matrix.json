                 "casbin_rule", "deployment", "deployment_provider_account", "file", "flow", "flow_version", "flow_version_deployment_attachment", "folder", "ingestion_run",
                 "job", "knowledge_base", "memory_base", "memory_base_preprocessing_output", "memory_base_session", "memory_base_workflow_run", "message",
                 "message_ingestion_record", "span", "sso_config", "sso_user_profile", "trace", "transaction", "user", "variable", "vertex_build"],
      "sequences": ["casbin_rule_id_seq"],
      "enum_types": ["access_type_enum", "deployment_provider_key_enum", "deployment_type_enum", "job_status_enum", "job_type_enum", "spankind", "spanstatus", "spantype"]
    }
