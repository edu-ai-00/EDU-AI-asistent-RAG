-- GENERATED from postgres/role_contract/matrix.json; do not edit by hand.
-- In database edu_ai, as a superuser. Variable src = the role that owns the objects now (edu_ai_admin on a clean install, the old bootstrap role on adoption).
\set ON_ERROR_STOP on
SET search_path = pg_catalog, pg_temp;
\if :{?src}
\else
\set src edu_ai_admin
\endif
SELECT set_config('edu_ai.src', :'src', false);
DO $g$ DECLARE src text := current_setting('edu_ai.src'); bad text := ''; BEGIN IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname !~ '^pg_' AND rolname <> src AND rolname <> ALL (ARRAY['edu_ai', 'edu_ai_admin', 'edu_ai_ingest', 'edu_ai_langflow', 'edu_ai_migrator', 'edu_ai_owner', 'edu_ai_search']::text[])) THEN bad := bad || ' unknown_role'; END IF; IF NOT (ARRAY(SELECT datname::text FROM pg_database) @> ARRAY['edu_ai', 'langflow', 'postgres', 'template0', 'template1']::text[] AND ARRAY['edu_ai', 'langflow', 'postgres', 'template0', 'template1']::text[] @> ARRAY(SELECT datname::text FROM pg_database)) THEN bad := bad || ' databases'; END IF; IF EXISTS (SELECT 1 FROM pg_auth_members a JOIN pg_roles ro ON ro.oid = a.roleid JOIN pg_roles u ON u.oid = a.member WHERE ro.rolname !~ '^pg_' AND u.rolname !~ '^pg_' AND (ro.rolname, u.rolname) NOT IN (VALUES ('edu_ai_owner', 'edu_ai_migrator'))) THEN bad := bad || ' memberships'; END IF; IF NOT (ARRAY(SELECT nspname::text FROM pg_namespace WHERE nspname !~ '^pg_' AND nspname <> 'information_schema') @> ARRAY['edu_ai', 'paradedb', 'pdb', 'public']::text[] AND ARRAY['edu_ai', 'paradedb', 'pdb', 'public']::text[] @> ARRAY(SELECT nspname::text FROM pg_namespace WHERE nspname !~ '^pg_' AND nspname <> 'information_schema')) THEN bad := bad || ' schemas'; END IF; IF NOT (ARRAY(SELECT extname::text || chr(58) || extversion FROM pg_extension) @> ARRAY['pg_search:0.26.2', 'pg_trgm:1.6', 'plpgsql:1.0', 'unaccent:1.1', 'vector:0.8.7']::text[] AND ARRAY['pg_search:0.26.2', 'pg_trgm:1.6', 'plpgsql:1.0', 'unaccent:1.1', 'vector:0.8.7']::text[] @> ARRAY(SELECT extname::text || chr(58) || extversion FROM pg_extension)) THEN bad := bad || ' extensions'; END IF; IF NOT (ARRAY(SELECT c.relname::text FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'edu_ai' AND c.relkind IN ('r','p') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e')) @> ARRAY['answer_exclusion_rule', 'app_user', 'chunk_exclusion_rule', 'code_list', 'document_chunks', 'document_elements', 'document_metadata', 'document_tables', 'embedding_registry', 'grade_term', 'idempotency_key', 'ingestion_log', 'legal_entity', 'prompt_registry', 'qa_blocklist', 'qa_embedding', 'qa_entries', 'qa_feedback', 'qa_pack_manifest', 'qa_stopword', 'qa_synonym', 'qa_variants', 'question_answer_log', 'settings', 'staff_user', 'subject_term', 'system_message', 'taxonomy_binding', 'taxonomy_rules', 'ui_label', 'validity_period']::text[] AND ARRAY['answer_exclusion_rule', 'app_user', 'chunk_exclusion_rule', 'code_list', 'document_chunks', 'document_elements', 'document_metadata', 'document_tables', 'embedding_registry', 'grade_term', 'idempotency_key', 'ingestion_log', 'legal_entity', 'prompt_registry', 'qa_blocklist', 'qa_embedding', 'qa_entries', 'qa_feedback', 'qa_pack_manifest', 'qa_stopword', 'qa_synonym', 'qa_variants', 'question_answer_log', 'settings', 'staff_user', 'subject_term', 'system_message', 'taxonomy_binding', 'taxonomy_rules', 'ui_label', 'validity_period']::text[] @> ARRAY(SELECT c.relname::text FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'edu_ai' AND c.relkind IN ('r','p') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e'))) THEN bad := bad || ' tables'; END IF; IF NOT (ARRAY(SELECT c.relname::text FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'edu_ai' AND c.relkind IN ('v') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e')) @> ARRAY['qa_conversation_v', 'user_v']::text[] AND ARRAY['qa_conversation_v', 'user_v']::text[] @> ARRAY(SELECT c.relname::text FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'edu_ai' AND c.relkind IN ('v') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e'))) THEN bad := bad || ' views'; END IF; IF NOT (ARRAY(SELECT c.relname::text FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'edu_ai' AND c.relkind IN ('S') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e')) @> ARRAY['answer_exclusion_rule_id_seq', 'chunk_exclusion_rule_id_seq', 'code_list_id_seq', 'edu_ai_document_chunks_id_seq', 'edu_ai_document_elements_id_seq', 'edu_ai_document_tables_id_seq', 'grade_term_id_seq', 'ingestion_log_id_seq', 'prompt_registry_id_seq', 'qa_blocklist_id_seq', 'qa_feedback_id_seq', 'qa_synonym_id_seq', 'qa_variants_variant_id_seq', 'question_answer_log_id_seq', 'subject_term_id_seq', 'system_message_id_seq', 'taxonomy_binding_id_seq', 'taxonomy_rules_id_seq', 'ui_label_id_seq', 'validity_period_id_seq']::text[] AND ARRAY['answer_exclusion_rule_id_seq', 'chunk_exclusion_rule_id_seq', 'code_list_id_seq', 'edu_ai_document_chunks_id_seq', 'edu_ai_document_elements_id_seq', 'edu_ai_document_tables_id_seq', 'grade_term_id_seq', 'ingestion_log_id_seq', 'prompt_registry_id_seq', 'qa_blocklist_id_seq', 'qa_feedback_id_seq', 'qa_synonym_id_seq', 'qa_variants_variant_id_seq', 'question_answer_log_id_seq', 'subject_term_id_seq', 'system_message_id_seq', 'taxonomy_binding_id_seq', 'taxonomy_rules_id_seq', 'ui_label_id_seq', 'validity_period_id_seq']::text[] @> ARRAY(SELECT c.relname::text FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'edu_ai' AND c.relkind IN ('S') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e'))) THEN bad := bad || ' sequences'; END IF; IF EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'edu_ai' AND c.relkind IN ('m','f') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e')) THEN bad := bad || ' other_relations'; END IF; IF EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname IN ('public','paradedb','pdb') AND c.relkind IN ('r','p','v','m','f','S') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e')) THEN bad := bad || ' foreign_relations'; END IF; IF NOT (ARRAY(SELECT p.proname::text || chr(58) || p.prokind::text FROM pg_proc p JOIN pg_namespace s ON s.oid = p.pronamespace WHERE s.nspname = 'edu_ai' AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_proc'::regclass AND d.objid = p.oid AND d.deptype = 'e')) @> ARRAY['chunk_codes_valid:f', 'code_list_identity_is_immutable:f', 'codebook_owner_must_be_root:f', 'entity_grade_scope:f', 'grade_level:f', 'grade_levels_drift:f', 'language_selection_must_exist:f', 'provision_school_code_lists:f', 'qa_duplicate_questions:f', 'qa_entry_category_must_be_valid:f', 'qa_pack_drift:f', 'resolved_code_list:f', 'resolved_taxonomy_rules:f', 'settings_owner_must_be_root:f']::text[] AND ARRAY['chunk_codes_valid:f', 'code_list_identity_is_immutable:f', 'codebook_owner_must_be_root:f', 'entity_grade_scope:f', 'grade_level:f', 'grade_levels_drift:f', 'language_selection_must_exist:f', 'provision_school_code_lists:f', 'qa_duplicate_questions:f', 'qa_entry_category_must_be_valid:f', 'qa_pack_drift:f', 'resolved_code_list:f', 'resolved_taxonomy_rules:f', 'settings_owner_must_be_root:f']::text[] @> ARRAY(SELECT p.proname::text || chr(58) || p.prokind::text FROM pg_proc p JOIN pg_namespace s ON s.oid = p.pronamespace WHERE s.nspname = 'edu_ai' AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_proc'::regclass AND d.objid = p.oid AND d.deptype = 'e'))) THEN bad := bad || ' functions'; END IF; IF EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace s ON s.oid = p.pronamespace WHERE s.nspname IN ('public','paradedb','pdb') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_proc'::regclass AND d.objid = p.oid AND d.deptype = 'e')) THEN bad := bad || ' foreign_functions'; END IF; IF EXISTS (SELECT 1 FROM pg_type t JOIN pg_namespace s ON s.oid = t.typnamespace WHERE s.nspname IN ('edu_ai','public','paradedb','pdb') AND t.typtype IN ('e','d','r','m') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_type'::regclass AND d.objid = t.oid AND d.deptype = 'e')) THEN bad := bad || ' types'; END IF; IF EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'edu_ai' AND c.relkind IN ('r','p','v','S') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e') AND pg_get_userbyid(c.relowner) NOT IN (src, 'edu_ai_owner')) THEN bad := bad || ' foreign_owner'; END IF; IF EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace s ON s.oid = p.pronamespace WHERE s.nspname = 'edu_ai' AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_proc'::regclass AND d.objid = p.oid AND d.deptype = 'e') AND pg_get_userbyid(p.proowner) NOT IN (src, 'edu_ai_owner')) THEN bad := bad || ' foreign_function_owner'; END IF; IF bad <> '' THEN RAISE EXCEPTION 'baseline mismatch, nothing was written:%', bad; END IF; END $g$;
BEGIN;
SET LOCAL lock_timeout = '5s';
ALTER SCHEMA edu_ai OWNER TO edu_ai_owner;
DO $own$ DECLARE r record; BEGIN FOR r IN SELECT format('%I.%I', s.nspname, c.relname) AS rel, c.relkind FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'edu_ai' AND c.relkind IN ('r','p','v','S') AND pg_get_userbyid(c.relowner) = current_setting('edu_ai.src') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e') AND NOT (c.relkind = 'S' AND EXISTS (SELECT 1 FROM pg_depend o WHERE o.classid = 'pg_class'::regclass AND o.objid = c.oid AND o.refclassid = 'pg_class'::regclass AND o.deptype IN ('a','i'))) ORDER BY c.relname LOOP IF r.relkind = 'S' THEN EXECUTE format('ALTER SEQUENCE %s OWNER TO edu_ai_owner', r.rel); ELSE EXECUTE format('ALTER TABLE %s OWNER TO edu_ai_owner', r.rel); END IF; END LOOP; FOR r IN SELECT format('%I.%I(%s)', s.nspname, p.proname, pg_get_function_identity_arguments(p.oid)) AS fn FROM pg_proc p JOIN pg_namespace s ON s.oid = p.pronamespace WHERE s.nspname = 'edu_ai' AND pg_get_userbyid(p.proowner) = current_setting('edu_ai.src') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_proc'::regclass AND d.objid = p.oid AND d.deptype = 'e') LOOP EXECUTE format('ALTER FUNCTION %s OWNER TO edu_ai_owner', r.fn); END LOOP; IF current_setting('edu_ai.src') <> 'edu_ai_owner' AND (EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'edu_ai' AND c.relkind IN ('r','p','v','m','f','S') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e') AND pg_get_userbyid(c.relowner) = current_setting('edu_ai.src')) OR EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace s ON s.oid = p.pronamespace WHERE s.nspname = 'edu_ai' AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_proc'::regclass AND d.objid = p.oid AND d.deptype = 'e') AND pg_get_userbyid(p.proowner) = current_setting('edu_ai.src'))) THEN RAISE EXCEPTION 'objects of the old owner remain, rolled back'; END IF; END $own$;
-- PUBLIC: nothing; the application roles start from nothing too, so a re-run converges and no grant option survives
REVOKE ALL ON SCHEMA edu_ai, public, paradedb, pdb FROM PUBLIC;
REVOKE ALL ON SCHEMA edu_ai, public, paradedb, pdb FROM edu_ai_search, edu_ai_ingest, edu_ai_migrator, edu_ai_langflow;
REVOKE ALL ON ALL TABLES IN SCHEMA edu_ai FROM PUBLIC;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA edu_ai FROM PUBLIC;
REVOKE ALL ON ALL ROUTINES IN SCHEMA edu_ai FROM PUBLIC;
REVOKE ALL ON ALL TABLES IN SCHEMA edu_ai FROM edu_ai_search, edu_ai_ingest, edu_ai_migrator, edu_ai_langflow;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA edu_ai FROM edu_ai_search, edu_ai_ingest, edu_ai_migrator, edu_ai_langflow;
REVOKE ALL ON ALL ROUTINES IN SCHEMA edu_ai FROM edu_ai_search, edu_ai_ingest, edu_ai_migrator, edu_ai_langflow;
REVOKE ALL ON ALL TABLES IN SCHEMA paradedb, pdb FROM PUBLIC;
REVOKE ALL ON ALL ROUTINES IN SCHEMA paradedb, pdb FROM PUBLIC;
REVOKE ALL ON ALL TABLES IN SCHEMA paradedb, pdb FROM edu_ai_search, edu_ai_ingest, edu_ai_migrator, edu_ai_langflow;
REVOKE ALL ON ALL ROUTINES IN SCHEMA paradedb, pdb FROM edu_ai_search, edu_ai_ingest, edu_ai_migrator, edu_ai_langflow;
-- extension objects used at runtime: read/execute only
GRANT SELECT ON ALL TABLES IN SCHEMA paradedb, pdb TO edu_ai_search, edu_ai_ingest;
GRANT EXECUTE ON ALL ROUTINES IN SCHEMA paradedb, pdb TO edu_ai_search, edu_ai_ingest, edu_ai_owner;
-- schema USAGE
GRANT USAGE ON SCHEMA edu_ai TO edu_ai_search, edu_ai_ingest, edu_ai_owner;
GRANT USAGE ON SCHEMA public TO edu_ai_search, edu_ai_ingest, edu_ai_owner;
GRANT USAGE ON SCHEMA paradedb TO edu_ai_search, edu_ai_ingest, edu_ai_owner;
GRANT USAGE ON SCHEMA pdb TO edu_ai_search, edu_ai_ingest, edu_ai_owner;
GRANT EXECUTE ON ALL ROUTINES IN SCHEMA edu_ai TO edu_ai_search, edu_ai_ingest, edu_ai_owner;
-- tables: SELECT for the runtime roles, DML only per the explicit matrix
GRANT SELECT ON ALL TABLES IN SCHEMA edu_ai TO edu_ai_search, edu_ai_ingest;
GRANT INSERT ON edu_ai.code_list TO edu_ai_search;
GRANT INSERT, UPDATE, DELETE ON edu_ai.document_chunks TO edu_ai_ingest;
GRANT INSERT, UPDATE, DELETE ON edu_ai.document_elements TO edu_ai_ingest;
GRANT INSERT, UPDATE, DELETE ON edu_ai.document_metadata TO edu_ai_ingest;
GRANT INSERT, UPDATE, DELETE ON edu_ai.document_tables TO edu_ai_ingest;
GRANT INSERT, UPDATE, DELETE ON edu_ai.idempotency_key TO edu_ai_search;
GRANT INSERT ON edu_ai.ingestion_log TO edu_ai_ingest;
GRANT INSERT, UPDATE ON edu_ai.qa_embedding TO edu_ai_ingest;
GRANT DELETE ON edu_ai.qa_embedding TO edu_ai_search;
GRANT INSERT, UPDATE ON edu_ai.qa_entries TO edu_ai_ingest;
GRANT DELETE ON edu_ai.qa_entries TO edu_ai_search;
GRANT INSERT, UPDATE ON edu_ai.qa_pack_manifest TO edu_ai_ingest;
GRANT DELETE ON edu_ai.qa_pack_manifest TO edu_ai_search;
GRANT INSERT, UPDATE ON edu_ai.qa_variants TO edu_ai_ingest;
GRANT INSERT ON edu_ai.question_answer_log TO edu_ai_search;
GRANT INSERT ON edu_ai.staff_user TO edu_ai_search;
-- sequences: USAGE and SELECT (never UPDATE) for the tables a role may insert into
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.code_list'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_search', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.document_chunks'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_ingest', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.document_elements'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_ingest', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.document_metadata'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_ingest', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.document_tables'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_ingest', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.idempotency_key'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_search', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.ingestion_log'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_ingest', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.qa_embedding'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_ingest', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.qa_entries'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_ingest', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.qa_pack_manifest'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_ingest', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.qa_variants'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_ingest', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.question_answer_log'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_search', q); END LOOP; END $s$;
DO $s$ DECLARE q text; BEGIN FOR q IN SELECT DISTINCT format('%I.%I', ns.nspname, sq.relname) FROM pg_depend dep JOIN pg_class sq ON sq.oid = dep.objid AND sq.relkind = 'S' JOIN pg_namespace ns ON ns.oid = sq.relnamespace WHERE dep.refobjid = 'edu_ai.staff_user'::regclass AND dep.deptype IN ('a','i') LOOP EXECUTE format('GRANT USAGE, SELECT ON SEQUENCE %s TO edu_ai_search', q); END LOOP; END $s$;
-- later objects of the owner role: nothing for PUBLIC and no automatic grant; new tables and functions enter the matrix, then `db_roles.py reapply`
ALTER DEFAULT PRIVILEGES FOR ROLE edu_ai_owner REVOKE ALL ON TABLES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE edu_ai_owner REVOKE ALL ON SEQUENCES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE edu_ai_owner REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE edu_ai_owner REVOKE USAGE ON TYPES FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE edu_ai_owner REVOKE ALL ON TABLES FROM edu_ai_search, edu_ai_ingest, edu_ai_migrator, edu_ai_langflow;
ALTER DEFAULT PRIVILEGES FOR ROLE edu_ai_owner REVOKE ALL ON SEQUENCES FROM edu_ai_search, edu_ai_ingest, edu_ai_migrator, edu_ai_langflow;
ALTER DEFAULT PRIVILEGES FOR ROLE edu_ai_owner REVOKE ALL ON FUNCTIONS FROM edu_ai_search, edu_ai_ingest, edu_ai_migrator, edu_ai_langflow;
ALTER DEFAULT PRIVILEGES FOR ROLE edu_ai_owner REVOKE ALL ON TYPES FROM edu_ai_search, edu_ai_ingest, edu_ai_migrator, edu_ai_langflow;
ALTER DEFAULT PRIVILEGES FOR ROLE edu_ai_owner IN SCHEMA edu_ai REVOKE ALL ON TABLES FROM edu_ai_search, edu_ai_ingest, edu_ai_migrator, edu_ai_langflow;
