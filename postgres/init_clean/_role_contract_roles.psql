-- Roles (no passwords here: init sets them from the environment, adoption from the external .env). Idempotent.
\set ON_ERROR_STOP on
SET search_path = pg_catalog, pg_temp;
SELECT 'CREATE ROLE edu_ai_admin LOGIN SUPERUSER CREATEDB CREATEROLE REPLICATION BYPASSRLS INHERIT' WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'edu_ai_admin') \gexec
ALTER ROLE edu_ai_admin RESET search_path;
SELECT 'CREATE ROLE edu_ai_owner NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT' WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'edu_ai_owner') \gexec
ALTER ROLE edu_ai_owner NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT;
