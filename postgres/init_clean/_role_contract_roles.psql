-- any membership of or in a contract role that the matrix does not list is removed (pg_* roles included)
DO $m$ DECLARE r record; BEGIN FOR r IN SELECT ro.rolname AS rn, u.rolname AS mn FROM pg_auth_members a JOIN pg_roles ro ON ro.oid = a.roleid JOIN pg_roles u ON u.oid = a.member WHERE (u.rolname = ANY (ARRAY['edu_ai_admin', 'edu_ai_ingest', 'edu_ai_langflow', 'edu_ai_migrator', 'edu_ai_owner', 'edu_ai_search']::text[]) OR ro.rolname = ANY (ARRAY['edu_ai_admin', 'edu_ai_ingest', 'edu_ai_langflow', 'edu_ai_migrator', 'edu_ai_owner', 'edu_ai_search']::text[])) AND (ro.rolname, u.rolname) NOT IN (VALUES ('edu_ai_owner', 'edu_ai_migrator')) LOOP EXECUTE format('REVOKE %I FROM %I', r.rn, r.mn); END LOOP; END $m$;
GRANT edu_ai_owner TO edu_ai_migrator WITH INHERIT FALSE, SET TRUE;
