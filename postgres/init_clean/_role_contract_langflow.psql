-- GENERATED from postgres/role_contract/matrix.json; do not edit by hand.
-- In database langflow, as a superuser, ADOPTION and RESTORE only: vendor objects move to the langflow role.
-- (A clean install needs nothing here: the database is created with that owner and Langflow creates its tables as that role.)
\set ON_ERROR_STOP on
SET search_path = pg_catalog, pg_temp;
\if :{?src}
\else
\set src edu_ai_admin
\endif
SELECT set_config('edu_ai.src', :'src', false);
DO $g$ DECLARE src text := current_setting('edu_ai.src'); bad text := ''; BEGIN IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname !~ '^pg_' AND rolname <> src AND rolname <> ALL (ARRAY['edu_ai', 'edu_ai_admin', 'edu_ai_ingest', 'edu_ai_langflow', 'edu_ai_migrator', 'edu_ai_owner', 'edu_ai_search']::text[])) THEN bad := bad || ' unknown_role'; END IF; IF NOT (ARRAY(SELECT datname::text FROM pg_database) @> ARRAY['edu_ai', 'langflow', 'postgres', 'template0', 'template1']::text[] AND ARRAY['edu_ai', 'langflow', 'postgres', 'template0', 'template1']::text[] @> ARRAY(SELECT datname::text FROM pg_database)) THEN bad := bad || ' databases'; END IF; IF EXISTS (SELECT 1 FROM pg_auth_members a JOIN pg_roles ro ON ro.oid = a.roleid JOIN pg_roles u ON u.oid = a.member WHERE ro.rolname !~ '^pg_' AND u.rolname !~ '^pg_' AND (ro.rolname, u.rolname) NOT IN (VALUES ('edu_ai_owner', 'edu_ai_migrator'))) THEN bad := bad || ' memberships'; END IF; IF NOT (ARRAY(SELECT nspname::text FROM pg_namespace WHERE nspname !~ '^pg_' AND nspname <> 'information_schema') @> ARRAY['public']::text[] AND ARRAY['public']::text[] @> ARRAY(SELECT nspname::text FROM pg_namespace WHERE nspname !~ '^pg_' AND nspname <> 'information_schema')) THEN bad := bad || ' schemas'; END IF; IF NOT (ARRAY(SELECT extname::text || chr(58) || extversion FROM pg_extension) @> ARRAY['plpgsql:1.0']::text[] AND ARRAY['plpgsql:1.0']::text[] @> ARRAY(SELECT extname::text || chr(58) || extversion FROM pg_extension)) THEN bad := bad || ' extensions'; END IF; IF NOT (((ARRAY(SELECT c.relname::text FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'public' AND c.relkind IN ('r','p') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e')) @> ARRAY['alembic_version', 'apikey', 'authz_audit_log', 'authz_edit_lock', 'authz_role', 'authz_role_assignment', 'authz_share', 'authz_team', 'authz_team_member', 'casbin_rule', 'deployment', 'deploym