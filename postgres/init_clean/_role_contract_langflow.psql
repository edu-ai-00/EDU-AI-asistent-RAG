lic' AND t.typtype = 'e') @> ARRAY['access_type_enum', 'deployment_provider_key_enum', 'deployment_type_enum', 'job_status_enum', 'job_type_enum', 'spankind', 'spanstatus', 'spantype']::text[] AND ARRAY['access_type_enum', 'deployment_provider_key_enum', 'deployment_type_enum', 'job_status_enum', 'job_type_enum', 'spankind', 'spanstatus', 'spantype']::text[] @> ARRAY(SELECT t.typname::text FROM pg_type t JOIN pg_namespace s ON s.oid = t.typnamespace WHERE s.nspname = 'public' AND t.typtype = 'e'))) OR ((ARRAY(SELECT c.relname::text FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'public' AND c.relkind IN ('r','p') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e')) @> ARRAY[]::text[] AND ARRAY[]::text[] @> ARRAY(SELECT c.relname::text FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'public' AND c.relkind IN ('r','p') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e'))) AND (ARRAY(SELECT c.relname::text FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'public' AND c.relkind IN ('S') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e')) @> ARRAY[]::text[] AND ARRAY[]::text[] @> ARRAY(SELECT c.relname::text FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'public' AND c.relkind IN ('S') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e'))) AND (ARRAY(SELECT t.typname::text FROM pg_type t JOIN pg_namespace s ON s.oid = t.typnamespace WHERE s.nspname = 'public' AND t.typtype = 'e') @> ARRAY[]::text[] AND ARRAY[]::text[] @> ARRAY(SELECT t.typname::text FROM pg_type t JOIN pg_namespace s ON s.oid = t.typnamespace WHERE s.nspname = 'public' AND t.typtype = 'e')))) THEN bad := bad || ' vendor_objects'; END IF; IF EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'public' AND c.relkind IN ('v','m','f')) THEN bad := bad || ' other_relations'; END IF; IF EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace s ON s.oid = p.pronamespace WHERE s.nspname = 'public') THEN bad := bad || ' functions'; END IF; IF EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'public' AND c.relkind IN ('r','p','v','S') AND pg_get_userbyid(c.relowner) NOT IN (src, 'edu_ai_langflow')) THEN bad := bad || ' foreign_owner'; END IF; IF bad <> '' THEN RAISE EXCEPTION 'baseline mismatch, nothing was written:%', bad; END IF; END $g$;
BEGIN;
SET LOCAL lock_timeout = '5s';
DO $own$ DECLARE r record; BEGIN FOR r IN SELECT format('%I.%I', s.nspname, c.relname) AS rel, c.relkind FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'public' AND c.relkind IN ('r','p','v','S') AND pg_get_userbyid(c.relowner) = current_setting('edu_ai.src') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e') AND NOT (c.relkind = 'S' AND EXISTS (SELECT 1 FROM pg_depend o WHERE o.classid = 'pg_class'::regclass AND o.objid = c.oid AND o.refclassid = 'pg_class'::regclass AND o.deptype IN ('a','i'))) ORDER BY c.relname LOOP IF r.relkind = 'S' THEN EXECUTE format('ALTER SEQUENCE %s OWNER TO edu_ai_langflow', r.rel); ELSE EXECUTE format('ALTER TABLE %s OWNER TO edu_ai_langflow', r.rel); END IF; END LOOP; FOR r IN SELECT format('%I.%I', s.nspname, t.typname) AS ty FROM pg_type t JOIN pg_namespace s ON s.oid = t.typnamespace WHERE s.nspname = 'public' AND t.typtype = 'e' AND pg_get_userbyid(t.typowner) = current_setting('edu_ai.src') LOOP EXECUTE format('ALTER TYPE %s OWNER TO edu_ai_langflow', r.ty); END LOOP; IF current_setting('edu_ai.src') <> 'edu_ai_langflow' AND (EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace s ON s.oid = c.relnamespace WHERE s.nspname = 'public' AND c.relkind IN ('r','p','v','m','f','S') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e') AND pg_get_userbyid(c.relowner) = current_setting('edu_ai.src')) ) THEN RAISE EXCEPTION 'objects of the old owner remain, rolled back'; END IF; END $own$;
